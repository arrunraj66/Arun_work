	cd /home/intern/Documents/auv_middleware/build-asan && $(MAKE) $(MAKESILENT) -f apps/CMakeFiles/scan_step1_demo.dir/build.make apps/CMakeFiles/scan_step1_demo.dir/scan_step1_demo.cpp.s
.PHONY : scan_step1_demo.cpp.s

